# Snowflake connection. Copy to .env and fill in. NEVER commit .env.
SNOWFLAKE_ACCOUNT=your_org-your_account      # e.g. abcd-xy12345
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=BREAST_CANCER

# --- Auth: pick ONE of the two methods below ---
#
# (A) Key-pair (default). Leave SNOWFLAKE_AUTHENTICATOR unset. Generate a key pair and
#     register the PUBLIC key on your Snowflake user:
#       openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#       openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8      # path to your PKCS8 private key
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=          # only if the key is encrypted
#
# (B) Browser SSO. Uncomment the next line; the private-key vars above are then ignored.
#     Requires a SAML identity provider configured on the account. The connector caches
#     the token, so you're prompted once per run, not once per table.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Schema names inside the database
RAW_SCHEMA=RAW
OMOP_SCHEMA=OMOP
DEID_SCHEMA=ANALYTICS
